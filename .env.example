# ==============================================================================
# FasalSetu Environment Configuration
# ==============================================================================
# In production and hackathon demo runs via Docker Compose, PostgreSQL is used.
# SQLite is strictly reserved for test isolation in pytest (conftest.py).
# For local dev without Docker, either point to a local PostgreSQL instance or
# optionally set sqlite:///./fasalsetu_dev.db for offline development.
# ==============================================================================

# PostgreSQL Connection String (Default for Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@db:5432/fasalsetu_db

# Local PostgreSQL Alternative (uncomment if running uvicorn locally against host Postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fasalsetu_db

# Environment mode ('development' or 'production')
ENVIRONMENT=production

# Server host and port
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS origins (allow all for frontend dev integration)
CORS_ORIGINS=*

# Groq API Configuration for Feature 3 (Farmer Q&A Assistant), Feature 3B (Voice), and Feature 5 (Crop Diagnosis)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Authentication configuration for Feature 9 (Farmer & Buyer phone+password auth)
# Generate a secure 64-character secret with: python -c "import secrets; print(secrets.token_hex(32))"
# The backend will refuse to boot if unset or set to a placeholder string.
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7
